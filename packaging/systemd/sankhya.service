[Unit]
Description=SANKHYA — unified OLTP, OLAP and graph data server
Documentation=https://github.com/ajsinha/sankhya
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/sankhya-server start
Restart=on-failure
RestartSec=5s

# The stop signal has to be one the server handles. It handles SIGINT and SIGTERM, and
# systemd's default is SIGTERM, so this is a statement of fact rather than a change --- worth
# writing down because changing it silently to something unhandled turns every restart into
# a kill.
KillSignal=SIGTERM

# Longer than the server's drain deadline, which is 30s. `cargo xtask check-package` fails
# the build if this number is not greater, because the two live in different files and
# nothing else relates them: when this is the shorter of the two, every restart kills the
# server mid-drain and clients see resets that look like crashes.
TimeoutStopSec=45s

# The server writes its warehouse, its diagnostic history and its backup manifests. Nothing
# else needs to be writable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/sankhya
# The configuration is read, never written. `ProtectSystem=strict` already makes /etc
# read-only; this says the directory must exist, so a unit installed without one fails at
# start rather than at the first feed that never runs.
ReadOnlyPaths=/etc/sankhya

# Both of these were missing, and their absence produced a server that started and was
# configured by nothing. Configuration resolves to `config/application.yaml` *relative to the
# working directory*, and systemd's default working directory is `/` --- so the unit read
# `/config/application.yaml`, which does not exist, skipped it silently, and came up with no
# users, no roles, no policy, no TLS and a feed directory that does not exist. Naming the file
# is now also load-bearing: a `SANKHYA_CONFIG` that does not exist stops the server rather
# than being skipped.
WorkingDirectory=/var/lib/sankhya
Environment=SANKHYA_CONFIG=/etc/sankhya/application.yaml

Environment=SANKHYA_WAREHOUSE=/var/lib/sankhya/warehouse
Environment=SANKHYA_DATA_DIR=/var/lib/sankhya/.sankhya
Environment=SANKHYA_LISTEN=0.0.0.0:5433
# Loopback, deliberately. A metrics endpoint on every interface is a small permanent
# disclosure of the deployment's shape; point a collector at it through a sidecar or a
# node-local scrape rather than opening it.
Environment=SANKHYA_METRICS_LISTEN=127.0.0.1:9464

# The descriptor limit, which systemd otherwise leaves at whatever the login default is
# --- 1024 on most distributions. A connection is a descriptor, an open data file is a
# descriptor, and the server serves up to 1,024 connections at once (`MAX_CONNECTIONS` in
# `sankhya-api-pg`), so a limit of 1024 is reached by connections alone before a single
# table is read. `accept()` then returns EMFILE, which the server survives by pausing ---
# but pausing is a server refusing callers, and the fix for that is here rather than there.
LimitNOFILE=65535

User=sankhya
Group=sankhya

[Install]
WantedBy=multi-user.target
