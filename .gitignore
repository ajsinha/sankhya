# Python, for the deck generator (tools/deck/GUIDE.md says how to make it)
/.venv/
__pycache__/

# Rust
/target/
**/*.rs.bk
*.pdb

# Cargo
Cargo.lock.orig

# LibreOffice / Office lock and temp files
.~lock.*#
~$*
*.tmp

# Editors / IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# SANKHYA local runtime state (never commit data directories)
/data/
/.sankhya/
*.log

# Local config overrides and secrets
config.local.toml
.env
.env.*
!.env.example

# Benchmark and profiling output
/bench-results/
perf.data*
flamegraph.svg

# Coverage
/coverage/
*.profraw
lcov.info

# Build scratch — vendored source is extracted and compiled here
/.build/

# Python bytecode from the tooling in tools/
__pycache__/
*.pyc

# `pip install -e sdk/python` writes this beside the package. Ignored because several
# documents tell a reader to install the SDK that way and then to run an audit on a clean
# tree, and an untracked directory that the instructions themselves create makes the second
# instruction impossible to follow.
*.egg-info/
build/
dist/
config/application.local.*

# Criterion writes its reports into target/, which is already ignored; this is for a
# stray run from another directory.
/criterion/
